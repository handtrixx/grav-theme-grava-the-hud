{% extends 'partials/base.html.twig' %}

{# Full-text search results (SimpleSearch plugin), in the wiki docs layout.
   The rows themselves live in partials/wiki-search-results.html.twig. #}

{% block body %}
    <section id="body-wrapper" class="section wiki-search-page">
        <div class="container">
            {% embed 'partials/wiki-layout.html.twig' %}
                {% block item %}
                    <header class="wiki-page-header">
                        <h1>{{ 'THEME_GRAVA_HUD.WIKI.SEARCH_HEADLINE'|t }}</h1>
                        {% include 'partials/wiki-search-results.html.twig' %}
                    </header>
                {% endblock %}
            {% endembed %}
        </div>
    </section>
{% endblock %}
