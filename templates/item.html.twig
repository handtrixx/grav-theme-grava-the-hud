{% extends 'partials/base.html.twig' %}
{% set blog = page.find(header_var('blog_url')|defined(theme_var('blog-page'))) %}
{% set show_breadcrumbs = header_var('show_breadcrumbs', [page, blog])|defined(true) %}
{% set show_sidebar    = header_var('show_sidebar',    [page, blog])|defined(true) %}
{% set show_pagination = header_var('show_pagination', [page, blog])|defined(true) %}
{% set hero_image_name = page.header.hero_image %}

{# Hero image pages keep the Quark hero (it carries title, date and tags).
   Pages without one get the terminal header band instead, at the container
   edge like the blog listing. #}
{% block hero %}
    {% if hero_image_name %}
        {% set hero_image = page.media[hero_image_name] %}
        {% set content %}
            <h1>{{ page.title|strip_emoji }}</h1>
            {% if page.header.subtitle %}<p class="lead">{{ page.header.subtitle }}</p>{% endif %}
            {% include 'partials/blog/date.html.twig' %}
            {% include 'partials/blog/taxonomy.html.twig' %}
        {% endset %}
        {% include 'partials/hero.html.twig' with {id: 'blog-hero'} %}
    {% endif %}
{% endblock %}

{% block body %}
<section id="body-wrapper" class="section blog-listing">
    <div class="container">

        {% if not hero_image_name %}
            <header class="blog-page-header">
                <h1>{{ page.title|strip_emoji }}</h1>
                {% if page.header.subtitle %}<p class="lead">{{ page.header.subtitle }}</p>{% endif %}
                <div class="blog-page-meta">
                    {% include 'partials/blog/date.html.twig' %}
                    {% include 'partials/blog/taxonomy.html.twig' %}
                </div>
            </header>
        {% endif %}

        {% if show_breadcrumbs and config.plugins.breadcrumbs.enabled %}
            {% include 'partials/breadcrumbs.html.twig' %}
        {% endif %}

        {% embed 'partials/layout.html.twig' with {show_sidebar: show_sidebar, blog: blog} %}
            {% block item %}
                {% include 'partials/blog-item.html.twig' %}

                {# Related posts from the relatedpages plugin (tag and content
                   scoring); the plugin exposes the scored list as related_pages. #}
                {% if config.plugins.relatedpages.enabled and related_pages|default([])|length > 0 %}
                    <aside class="related-posts">
                        <h2 class="related-posts-headline">{{ 'THEME_GRAVA_HUD.SIDEBAR.RELATED_POSTS.HEADLINE'|t }}</h2>
                        {% include 'partials/relatedpages.html.twig' %}
                    </aside>
                {% endif %}
            {% endblock %}
            {% block sidebar %}
                {% include 'partials/sidebar.html.twig' %}
            {% endblock %}
        {% endembed %}

    </div>
</section>
{% endblock %}
