{% extends 'partials/base.html.twig' %}
{% import _self as wl %}

{# Wiki listing pages (the wiki root and every section): docs layout with the
   full tree in the sidebar, sections and entries in the main column. #}

{% block body %}
    <section id="body-wrapper" class="section wiki-listing">
        <div class="container">
            {% embed 'partials/wiki-layout.html.twig' %}
                {% block item %}
                    <header class="wiki-page-header">
                        <h1>{{ page.title }}</h1>
                        {% if page.header.subtitle %}
                            <p class="lead">{{ page.header.subtitle }}</p>
                        {% endif %}
                        {% if page.content|striptags|trim is not empty %}
                            <div class="wiki-page-intro">{{ page.content|raw }}</div>
                        {% endif %}
                    </header>
                    {% include 'partials/wiki-listing.html.twig' %}
                {% endblock %}
            {% endembed %}
        </div>
    </section>
{% endblock %}
