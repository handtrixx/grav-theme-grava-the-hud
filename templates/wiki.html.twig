{% extends 'partials/base.html.twig' %}

{# Wiki pages in the docs layout. Pages with children render as a listing
   (sections with entries, excerpts and dates); pages without children render
   as an article with breadcrumbs and prev/next. grava-the-hud.php assigns
   this template to every page under /wiki that has no template of its own. #}
{% set show_breadcrumbs = header_var('show_breadcrumbs')|defined(true) %}
{% set children = page.children|filter(p => p.published) %}

{% block body %}
    <section id="body-wrapper" class="section{{ children|length ? ' wiki-listing' : ' wiki-article' }}">
        <div class="container">
            {% embed 'partials/wiki-layout.html.twig' %}
                {% block item %}
                    {% if show_breadcrumbs %}
                        {% include 'partials/wiki-breadcrumbs.html.twig' %}
                    {% endif %}
                    {% if children|length %}
                        <header class="wiki-page-header">
                            <h1>{{ page.title }}</h1>
                            {% if page.header.subtitle %}
                                <p class="lead">{{ page.header.subtitle }}</p>
                            {% endif %}
                            {% if page.content|striptags|trim is not empty %}
                                <div class="wiki-page-intro">{{ page.content|raw }}</div>
                            {% endif %}
                        </header>
                        {% include 'partials/wiki-listing.html.twig' %}
                    {% else %}
                        <article class="content-item">
                            {{ page.content|raw }}
                        </article>
                        {% include 'partials/wiki-prevnext.html.twig' %}
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
    </section>
{% endblock %}
