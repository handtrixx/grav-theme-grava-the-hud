{% extends 'partials/base.html.twig' %}
{# Home page: hero from the page content, then teasers for the main sections,
   a recent-transmissions list (newest blog posts, most recently edited wiki
   articles) and a readout of what the site holds. All derived from the
   section pages, so it stays correct in en and de and needs no maintenance. #}
{% import 'partials/wiki-macros.html.twig' as wm %}

{% block content %}
    <article class="content-item">
        {{ page.content|raw }}

        {% set de = grav.language.getActive == 'de' %}
        {% set go = de ? 'öffnen' : 'open' %}

        {% set blog = page.find('/blog') %}
        {% set wiki = page.find('/wiki') %}
        {% set zoo = page.find('/zoo') %}

        {# Wiki articles live one and two folders below /wiki; collect them all
           so the recent list shows articles, not section pages. #}
        {% set wiki_articles = [] %}
        {% for sec in wiki.children %}
            {% for p in sec.children %}
                {# Only articles: section pages share the wiki template and are
                   not content worth surfacing as "recent". #}
                {% if p.published and p.template != 'wiki' %}
                    {% set wiki_articles = wiki_articles|merge([p]) %}
                {% endif %}
                {% for q in p.children %}
                    {% if q.published and q.template != 'wiki' %}
                        {% set wiki_articles = wiki_articles|merge([q]) %}
                    {% endif %}
                {% endfor %}
            {% endfor %}
        {% endfor %}

        <p class="hud-ls-head"><span class="prompt">$</span> ls -al ~/sites</p>
        <section class="hud-teasers" aria-label="{{ de ? 'Seitenbereiche' : 'Site sections' }}">
            {% for route in ['/blog', '/wiki', '/zoo', '/about'] %}
                {% set s = page.find(route) %}
                {% if s and s.published %}
                    <a class="hud-teaser" href="{{ s.url }}">
                        <span class="hud-teaser-kicker">$ cd {{ s.route|split('/')|last|lower }}/</span>
                        <h2>{{ wm.clean_title(s) }}</h2>
                        {{ wm.excerpt(s) }}
                        <span class="hud-teaser-foot">
                            {{ wm.date(s) }}
                            <span class="hud-teaser-go">{{ go }} →</span>
                        </span>
                    </a>
                {% endif %}
            {% endfor %}
        </section>

        {% set posts = blog ? blog.collection|slice(0, 3) : [] %}
        {# This Grav's Twig build only accepts an arrow comparator for sort, not
           `attribute=`; newest first via spaceship, then take three. #}
        {# Sort on the front-matter date when present (mtime is bumped by every
           GitSync deploy), else on the file mtime. #}
        {% set recent_wiki = wiki_articles|sort((a, b) => (a.header.date ?: a.modified) <=> (b.header.date ?: b.modified))|reverse|slice(0, 3) %}

        <section class="hud-recent" aria-label="{{ de ? 'Das Neueste' : 'Latest' }}">
            {% if posts %}
                <p class="hud-ls-head"><span class="prompt">$</span> tail -n 3 ~/blog</p>
                <ul class="hud-recent-list">
                    {% for p in posts %}{{ wm.search_row(p) }}{% endfor %}
                </ul>
            {% endif %}

            {% if recent_wiki %}
                <p class="hud-ls-head"><span class="prompt">$</span> git log --oneline -3 ~/wiki</p>
                <ul class="hud-recent-list">
                    {% for p in recent_wiki %}{{ wm.search_row(p) }}{% endfor %}
                </ul>
            {% endif %}
        </section>

        {# The blog collection is paginated (10 per page), so its count says
           "posts on this page". Count the children instead: the whole blog.
           Iterating children works; the collection's `count` method does not
           resolve in this Grav build, so use the length filter.
           The zoo count is the live repository list from GitHub (cached 6h),
           falling back to the curated pages when the API is unreachable. #}
        {% set repos = github_repos() %}
        <div class="hud-stats" aria-label="{{ de ? 'Bestand' : 'What this site holds' }}">
            <span class="hud-stat"><em>~/blog</em><b>{{ blog ? blog.children|length : 0 }}</b>{{ de ? ' Beiträge' : ' posts' }}</span>
            <span class="hud-stat"><em>~/wiki</em><b>{{ wiki_articles|length }}</b>{{ de ? ' Seiten' : ' pages' }}</span>
            <span class="hud-stat"><em>~/zoo</em><b>{{ repos|length > 0 ? repos|length : (zoo ? zoo.children|length : 0) }}</b>{{ de ? ' Projekte' : ' projects' }}</span>
        </div>
    </article>
{% endblock %}
