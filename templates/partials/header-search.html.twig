{# Header search: a pill button that opens the search palette (js/hud-search.js
   owns the Ctrl K / "/" shortcut and draws the kbd hint, ⌘ K on macOS). Used
   in the desktop navbar and in the mobile overlay menu. No form: search is
   fully client-side, there is no results page to submit to. #}
<button type="button" class="hud-search" data-open-search
        aria-label="{{ 'THEME_GRAVA_HUD.HEADER.SEARCH_LABEL'|t|e('html_attr') }}"
        aria-haspopup="dialog">
    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    <span class="hud-search-text">{{ 'THEME_GRAVA_HUD.HEADER.SEARCH_PLACEHOLDER'|t }}</span>
    <kbd class="hud-search-kbd" data-search-shortcut>Ctrl K</kbd>
</button>
