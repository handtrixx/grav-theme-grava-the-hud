{% set body_classes = body_class(['header-fixed', 'header-animated', 'header-transparent', 'header-dark', 'header-light', 'sticky-footer', 'layout-fluid']) %}
{% set theme_default = theme_var('theme-mode') ?: 'auto' %}
{% set accent = theme_var('accent-color') %}
{% set accent_is_hex = accent and accent matches '/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/' %}
{% set fa_enabled = theme_var('fontawesome.enabled') %}
{% set fa_local   = theme_var('fontawesome.local') %}
{% set favicon = theme_var('custom_favicon') %}
{% set favicon_first = (favicon is iterable and favicon|length > 0) ? favicon|first : null %}
{% set favicon_file = favicon_first.name|default(null) %}
{% set favicon_url = favicon_file ? url('theme://images/favicon/' ~ favicon_file) : null %}
{% set favicon_type = favicon_url ? ({'svg': 'image/svg+xml', 'ico': 'image/x-icon'}[favicon_file|split('.')|last|lower]|default('image/png')) : 'image/png' %}
{% use 'blocks/base.html.twig' %}
<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}"
      data-theme-default="{{ theme_default }}"
      data-lang-supported="{{ grav.language.getLanguages|join(',') }}"
      data-lang-default="{{ grav.config.site.default_lang }}">
<head>
{% block head deferred %}
    <meta charset="utf-8" />
    <title>{% if page.title %}{{ page.title|e('html') }} | {% endif %}{{ site.title|e('html') }}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">

    {% include 'partials/metadata.html.twig' %}

    <link rel="icon" type="{{ favicon_type }}" href="{{ favicon_url ?: url('theme://images/favicon.png') }}" />
    {# Browser chrome color: without theme-color the browser samples the
       artwork instead and picked the (old, purple) favicon. #}
    {% if accent_is_hex %}
    <meta name="theme-color" content="{{ accent }}" />
    {% endif %}
    <link rel="canonical" href="{{ page.url(true, true) }}" />

    {# Feed autodiscovery + structured data (see partials/seo-jsonld.html.twig) #}
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} — Blog" href="{{ site.url ~ base_url ~ '/feed.rss' }}" />
    {% include 'partials/seo-jsonld.html.twig' %}

    {# Preload the critical latin subsets so headings + body text render in-font on first paint #}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url('theme://fonts/cal-sans/cal-sans-latin.cc7be70f8e.woff2') }}" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url('theme://fonts/inter/inter-latin.c940764593.woff2') }}" />

    {% if accent_is_hex %}
    {# User-configured accent: tint links, focus ring, and filled UI accents with the chosen hex #}
    <style>
      :root {
        --q2-accent: {{ accent }};
        --q2-accent-contrast: #ffffff;
        /* links carry the accent but must clear 4.5:1 as body-size text:
           raw #18a98a on paper is 2.86:1. Mixing toward the theme text color
           darkens on light and lightens on dark in one rule. (2026-11-27) */
        --q2-link: color-mix(in oklab, {{ accent }} 55%, var(--q2-text));
        --q2-focus-ring: color-mix(in oklab, {{ accent }} 45%, transparent);
      }
      :root[data-theme='dark'] {
        --q2-accent: color-mix(in oklab, {{ accent }} 80%, white 20%);
        --q2-accent-contrast: #ffffff;
        --q2-link: color-mix(in oklab, {{ accent }} 75%, white 25%);
        --q2-focus-ring: color-mix(in oklab, {{ accent }} 45%, transparent);
      }
    </style>
    {% endif %}

    {# Pre-paint theme bootstrap — blocks FOUC by setting data-theme synchronously #}
    <script>
    (function () {
      try {
        var d = document.documentElement;
        var stored = localStorage.getItem('grava-theme') || localStorage.getItem('quark2-theme');
        var mode = (stored === 'light' || stored === 'dark')
          ? stored
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        d.setAttribute('data-theme', mode);
        d.setAttribute('data-theme-preference', mode);
        d.classList.toggle('dark', mode === 'dark');
      } catch (e) {}
    })();
    </script>
{% endblock head %}

{% block stylesheets %}
    {% do assets.addCss('theme://css/fonts.css', 100) %}
    {% do assets.addCss('theme://css/blades.min.css', 95) %}
    {% do assets.addCss('theme://css/theme.css', 90) %}
    {% if fa_enabled %}
        {% if fa_local %}
            {% do assets.addCss('theme://css/fontawesome/all.min.css', 85) %}
        {% else %}
            {% do assets.addCss('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css', 85) %}
        {% endif %}
    {% endif %}
    {% do assets.addCss('theme://css/custom.css', 80) %}
    {# Wiki docs layout (sidebar, tree, TOC) on wiki + search pages; the
       entry-row styles also carry the home page's recent lists. #}
    {% if page.template in ['wiki', 'wiki-article', 'search', 'home'] %}
        {% do assets.addCss('theme://css/wiki-docs.css', 75) %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {% do assets.addJs('theme://js/theme-toggle.js', {group:'head', priority: 100}) %}
    {% do assets.addJs('theme://js/language-toggle.js', {group:'head', priority: 110}) %}
    {% do assets.addJs('theme://js/site.js', {group:'bottom', priority: 100}) %}
    {# Wiki tree: collapse, live filter, TOC, mobile drawer (wiki pages only). #}
    {% if page.template in ['wiki', 'wiki-article'] %}
        {% do assets.addJs('theme://js/wiki.js', {group:'bottom', priority: 110}) %}
    {% endif %}
    {# Search palette (Ctrl K / "/"): small script, the page index is fetched
       only when the palette first opens. No server-side results page. #}
    {% do assets.addJs('theme://js/hud-search.js', {group:'bottom', priority: 130}) %}
    {# About-page wireframe head (hud-flat pages). Classic script on purpose:
       hud-head.js dynamic-imports three + GLTFLoader (resolved by the importmap
       in the bottom block) only when the stage is visible and near the viewport,
       so mobile never fetches ~1.1 MB for a CSS-hidden element. Registered via
       assets so the URL carries Grav's content timestamp (theme JS is served
       immutable). #}
    {% if "hud-flat" in body_classes %}
        {% do assets.addJs('theme://js/hud-head.js', {group:'bottom', priority: 120}) %}
    {% endif %}
{% endblock %}

{% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
{% endblock %}
</head>
<body id="top" class="{% block body_classes %}{{ body_classes }}{% endblock %}">
    <div id="page-wrapper">
    {% block header %}
        <header id="header" class="section">
            <div class="container">
                <nav class="navbar" aria-label="{{ 'THEME_GRAVA_HUD.ARIA.PRIMARY_NAV'|t|e('html_attr') }}">
                    <div class="navbar-section logo">
                        {% include 'partials/logo.html.twig' %}
                    </div>
                    <div class="navbar-section desktop-menu">
                        <div class="dropmenu">
                        {% block header_navigation %}
                            {% include 'partials/navigation.html.twig' %}
                        {% endblock %}
                        </div>
                        {% block header_search %}
                            {% include 'partials/header-search.html.twig' %}
                        {% endblock %}
                    </div>
                    <div class="navbar-section actions">
                        {% include 'partials/language-toggle.html.twig' %}
                        {% include 'partials/theme-toggle.html.twig' %}
                        {% if config.plugins.login.enabled and grav.user.username %}
                            <span class="login-status-wrapper"><i class="fa-solid fa-user" aria-hidden="true"></i> {% include 'partials/login-status.html.twig' ignore missing %}</span>
                        {% endif %}
                    </div>
                </nav>
            </div>
        </header>
        <div class="mobile-menu">
            <div class="mobile-actions">
                {% include 'partials/language-toggle.html.twig' %}
                {% include 'partials/theme-toggle.html.twig' %}
            </div>
            <button type="button" class="button_container" id="toggle" aria-label="{{ 'THEME_GRAVA_HUD.ARIA.OPEN_MENU'|t|e('html_attr') }}">
                <span class="top"></span>
                <span class="middle"></span>
                <span class="bottom"></span>
            </button>
        </div>
    {% endblock %}

    {% block hero %}{% endblock %}

        <main id="start">
        {% block body %}
            <section id="body-wrapper" class="section">
                <div class="container">
                    {% block messages %}
                        {% include 'partials/messages.html.twig' ignore missing %}
                    {% endblock %}
                    {{ block('content_surround') }}
                </div>
            </section>
        {% endblock %}
        </main>

    </div>

    {% block footer %}
        {% include 'partials/footer.html.twig' %}
    {% endblock %}

    {# Search palette: a roll-up modal over the page (Ctrl K / "/"). Results
       are filtered client-side from /search.json (theme PHP route). #}
    <div class="hud-palette" id="hud-palette" hidden>
        <div class="hud-palette-backdrop" data-palette-close></div>
        <div class="hud-palette-panel" role="dialog" aria-modal="true"
             aria-label="{{ 'THEME_GRAVA_HUD.SEARCH.HEADLINE'|t|e('html_attr') }}">
            <div class="hud-palette-form">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="text" id="hud-palette-input" class="hud-palette-input"
                       role="combobox" aria-expanded="false" aria-controls="hud-palette-list"
                       autocomplete="off" autocapitalize="off" spellcheck="false"
                       placeholder="{{ 'THEME_GRAVA_HUD.SEARCH.PALETTE_PLACEHOLDER'|t|e('html_attr') }}"
                       aria-label="{{ 'THEME_GRAVA_HUD.SEARCH.PALETTE_LABEL'|t|e('html_attr') }}">
                <button type="button" class="hud-palette-close" data-palette-close
                        aria-label="{{ 'THEME_GRAVA_HUD.SEARCH.CLOSE'|t|e('html_attr') }}">&times;</button>
            </div>
            <p class="hud-palette-status" id="hud-palette-status" role="status" aria-live="polite"></p>
            <ul class="hud-palette-list" id="hud-palette-list" role="listbox"
                data-status-one="{{ 'THEME_GRAVA_HUD.SEARCH.RESULTS_ONE'|t|e('html_attr') }}"
                data-status-many="{{ 'THEME_GRAVA_HUD.SEARCH.RESULTS_MANY'|t|e('html_attr') }}"
                data-status-none="{{ 'THEME_GRAVA_HUD.SEARCH.RESULTS_NONE'|t|e('html_attr') }}"
                data-loading="{{ 'THEME_GRAVA_HUD.SEARCH.LOADING'|t|e('html_attr') }}"
                data-label-blog="{{ 'THEME_GRAVA_HUD.SEARCH.GROUP_POSTS'|t|e('html_attr') }}"
                data-label-wiki="{{ 'THEME_GRAVA_HUD.SEARCH.GROUP_WIKI'|t|e('html_attr') }}"
                data-label-zoo="{{ 'THEME_GRAVA_HUD.SEARCH.GROUP_ZOO'|t|e('html_attr') }}"
                data-label-page="{{ 'THEME_GRAVA_HUD.SEARCH.GROUP_PAGES'|t|e('html_attr') }}"
                aria-label="{{ 'THEME_GRAVA_HUD.SEARCH.HEADLINE'|t|e('html_attr') }}"></ul>
            <div class="hud-palette-hint">{{ 'THEME_GRAVA_HUD.SEARCH.PALETTE_HINT'|t }}</div>
        </div>
    </div>

    {% block mobile %}
    <div class="mobile-container">
        <div class="overlay" id="overlay" role="dialog" aria-label="{{ 'THEME_GRAVA_HUD.ARIA.MENU'|t|e('html_attr') }}">
            <div class="mobile-logo">
                {% include 'partials/logo.html.twig' with {mobile: true} %}
            </div>
            <nav class="overlay-menu" aria-label="{{ 'THEME_GRAVA_HUD.ARIA.MOBILE_NAV'|t|e('html_attr') }}">
                {% include 'partials/header-search.html.twig' %}
                {% include 'partials/navigation.html.twig' with {tree: true} %}
            </nav>
        </div>
    </div>
    {% endblock %}

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% if "hud-flat" in body_classes %}
    {# Importmap for hud-head.js's dynamic imports; three files are content-hashed
       in their filenames (immutable caching), bump the hashes on upgrade and
       re-apply the internal core import in three.module.*.js. #}
    <script type="importmap">{"imports":{"three":"/user/themes/grava-the-hud/js/three.module.e2b5ee6bcc.js","three/addons/":"/user/themes/grava-the-hud/js/addons-e2b5ee6bcc/"}}</script>
    {% endif %}
    {# Rung-1 state (2026-11-28 bisect): cross-document view transitions are
       OUT (Vivaldi 8.3 swallows the first nav click - see custom.css note).
       Speculation rules are back WITHOUT VT: prerender conservative only. #}
    {% include 'partials/speculation-rules.html.twig' %}
{% endblock %}
</body>
</html>
