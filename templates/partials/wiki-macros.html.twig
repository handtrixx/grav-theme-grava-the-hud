{% import _self as wm %}

{# Shared row helpers, imported by wiki-listing and wiki-search-results.
   This file defines macros only — importing it renders nothing of its own. #}

{% macro clean_text(text) %}
    {{ text|replace({'🌲 ': '', '🎵 ': '', '💬 ': '', '📁 ': '', '🔑 ': '', '🔒 ': '', '🔍 ': '', '📖 ': '', '🗄️ ': '', '🖥️ ': '', '🛡️ ': '', '🎬 ': '', '📚 ': '', '🧰 ': '', '🎯 ': '', '🔧 ': '', '🐳 ': '', '📝 ': '', '🌐 ': '', '⚙️ ': '', '📡 ': '', '🅿️ ': '', '🏕️ ': '', '💡 ': '', '🖨️ ': '', '🌲': '', '🎵': '', '💬': '', '📁': '', '🔑': '', '🔒': '', '🔍': '', '📖': '', '🗄️': '', '🖥️': '', '🛡️': '', '🎬': '', '📚': '', '🧰': '', '🎯': '', '🔧': '', '🐳': '', '📝': '', '🌐': '', '⚙️': '', '📡': '', '🅿️': '', '🏕️': '', '💡': '', '🖨️': ''})|trim }}
{% endmacro %}

{% macro clean_title(p) %}
    {{ wm.clean_text(p.title) }}
{% endmacro %}

{% macro excerpt(p) %}
    {# Auto excerpt: description if set, else the summary. Raw-markdown noise
       (alert markers, image lines) is dropped, the emoji decoration and the
       auto-prepended title are stripped; nothing shown when what remains
       repeats the title. #}
    {% set text = p.header.description ?: (p.summary|striptags|trim) %}
    {% if text %}
        {% set clean = [] %}
        {% for line in text|split('\n') %}
            {% if line|trim and not (line starts with ':::') and not ('![' in line) %}
                {% set clean = clean|merge([line|trim]) %}
            {% endif %}
        {% endfor %}
        {% set text = wm.clean_text(clean|join(' ')) %}
        {% if text|lower starts with p.title|lower %}
            {% set text = text|slice(p.title|length)|trim %}
        {% endif %}
        {% if text and text|lower != p.title|lower %}
            <p class="wiki-entry-excerpt">{{ text|length > 220 ? text|slice(0, 220) ~ '…' : text }}</p>
        {% endif %}
    {% endif %}
{% endmacro %}

{% macro date(p) %}
    {% set updated = p.modified|default(null) %}
    {% if updated %}
        <span class="wiki-entry-date">{{ updated|date('d-m-Y') }}</span>
    {% endif %}
{% endmacro %}
