{# Shared row helpers, imported by wiki-listing and wiki-search-results.
   This file defines macros only — importing it renders nothing of its own.
   Nested calls use _self: macros imported into a template body are not
   available inside other macro bodies. #}

{% macro clean_text(text) %}
    {# strip_emoji (grava-the-hud.php) drops any symbol, pictogram or zero-width
       joiner/variation selector, instead of a hand-written emoji list. #}
    {{ text|strip_emoji }}
{% endmacro %}

{% macro clean_title(p) %}
    {{ _self.clean_text(p.title) }}
{% endmacro %}

{% macro excerpt(p) %}
    {# Auto excerpt: description if set, else the summary. Raw-markdown noise
       (alert markers, image lines) is dropped, the emoji decoration and the
       auto-prepended title are stripped; nothing shown when what remains
       repeats the title. #}
    {% set text = p.header.description ?: (p.summary|striptags|trim) %}
    {# Auto-generated summaries are escaped HTML (&#039;, &quot;, &amp;);
       decoded here so excerpts read as plain text. #}
    {% if text %}
        {% set text = text|replace({'&#039;': "'", '&quot;': '"', '&amp;': '&', '&#39;': "'"}) %}
        {% set clean = [] %}
        {% for line in text|split('\n') %}
            {# Drop markdown headings (the auto-prepended title), alert
               markers and image lines; striptags alone leaves `#` markdown. #}
            {% if line|trim and not (line starts with ':::') and not (line starts with '#') and not ('![' in line) %}
                {% set clean = clean|merge([line|trim]) %}
            {% endif %}
        {% endfor %}
        {% set text = _self.clean_text(clean|join(' '))|trim %}
        {# Macro output carries the body's indentation, so trim before comparing #}
        {% set plain = _self.clean_title(p)|trim %}
        {% if text|lower starts with plain|lower %}
            {% set text = text|slice(plain|length)|trim %}
        {% endif %}
        {% if text and text|lower != plain|lower %}
            {# striptags removes tag-like substrings entirely, so printing raw
               is safe; angle brackets that survive are re-escaped. Escaping
               quotes/apostrophes would show them as &#039;/&quot; text. #}
            <p class="wiki-entry-excerpt">{{ (text|length > 220 ? text|slice(0, 220) ~ '…' : text)|replace({'<': '&lt;', '>': '&gt;'})|raw }}</p>
        {% endif %}
    {% endif %}
{% endmacro %}

{% macro date(p) %}
    {% set updated = p.modified|default(null) %}
    {% if updated %}
        <span class="wiki-entry-date">{{ updated|date('d-m-Y') }}</span>
    {% endif %}
{% endmacro %}

{# Folder trail for search rows: "Wiki / Projects" without emoji decoration,
   for any section — blog posts read as "Blog". Stops at the site root. #}
{% macro trail(p, depth) %}
    {% if p and depth > 0 and p.route != '' %}
        {% if p.parent and p.parent.route != '' %}
            {{ _self.trail(p.parent, depth - 1) }} / {{ _self.clean_title(p) }}
        {% else %}
            {{ _self.clean_title(p) }}
        {% endif %}
    {% endif %}
{% endmacro %}

{# One search-result row: title, folder trail + modified date stacked on the
   right, excerpt. Listing rows use entry_row, which has no path. #}
{% macro search_row(p) %}
    <li class="wiki-entry">
        <a class="wiki-entry-title" href="{{ p.url }}">{{ _self.clean_title(p) }}</a>
        <span class="wiki-entry-meta">
            {% if p.parent and p.parent.route != '' %}
                <span class="wiki-entry-path">{{ _self.trail(p.parent, 5) }}</span>
            {% endif %}
            {{ _self.date(p) }}
        </span>
        {{ _self.excerpt(p) }}
    </li>
{% endmacro %}
