{% import "macros/macros.html.twig" as macros %}

{# Grav 2 has no "pages" global in the template context (only page + grav);
   build the menu from the root page children. Home leads the menu, then the
   other visible sections in Grav's own order. #}
{% set nav_pages = grav.pages.root|default(pages) %}
{% set nav_items = [] %}
{% set rest_items = [] %}
{% for p in nav_pages.children.visible %}
  {% if p.folder == 'home' %}
    {% set nav_items = nav_items|merge([p]) %}
  {% else %}
    {% set rest_items = rest_items|merge([p]) %}
  {% endif %}
{% endfor %}
{% set nav_items = nav_items|merge(rest_items) %}
<ul {{ tree ? "class=\"tree navigation\"" : "class=\"navigation\"" }}>
    {% for p in nav_items %}
      {% set active_page = (p.active or p.activeChild) ? 'active' : '' %}
      {% set has_children = p.children.visible.count > 0 %}
      <li{% if has_children %} class="has-children"{% endif %}>
        <a href="{{ p.url }}" class="{{ active_page }}">
          {% if p.header.menu_icon %}<i class="{{ p.header.menu_icon|fa_icon }}" aria-hidden="true"></i>{% endif %}
          {{ p.menu }}
        </a>
        {% if has_children %}
        <ul>
          {{ macros.nav_loop(p) }}
        </ul>
        {% endif %}
      </li>
    {% endfor %}
</ul>
