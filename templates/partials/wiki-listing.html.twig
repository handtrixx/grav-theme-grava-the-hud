{% import 'partials/wiki-macros.html.twig' as wm %}

{# Sections and entries for a wiki page that has children. Folder children
   render as their own section (their pages listed underneath); pages render
   directly in a flat list. #}
{% for section in page.children|filter(p => p.published)|sort((a, b) => a.title <=> b.title) %}
    {% set entries = section.children|filter(p => p.published)|sort((a, b) => a.title <=> b.title) %}
    {% if entries|length %}
        <section class="wiki-section">
            <h2>
                <a href="{{ section.url }}">{{ wm.clean_title(section) }}</a>
                <span class="wiki-section-count">{{ entries|length }}</span>
            </h2>
            {# Section intros are EXCERPTS, never the full page: dumping whole
               pages (tables and all) onto the index buried the listing
               (Niklas, 2026-11-25). Same macro as the entry rows; falls back
               to the first 220 plain chars when the section has no
               description/summary. #}
            {% if section.header.description or section.summary|trim %}
                {{ wm.excerpt(section) }}
            {% else %}
                {% set lines = [] %}
                {% for line in section.content|without_first_heading|striptags|split('\n') %}
                    {% set line = line|trim %}
                    {% if line and not (line starts with '#') and not (line starts with ':::') and not ('![' in line) and not (line starts with '|') %}
                        {% set lines = lines|merge([line]) %}
                    {% endif %}
                {% endfor %}
                {% set intro = lines|join(' ')|replace({'<': '&lt;', '>': '&gt;'}) %}
                {% if intro|trim %}
                    <p class="wiki-entry-excerpt">{{ (intro|length > 220 ? intro|slice(0, 220) ~ '…' : intro)|raw }}</p>
                {% endif %}
            {% endif %}
            <ul class="wiki-entry-list">
                {% for p in entries %}
                    <li class="wiki-entry">
                        <a class="wiki-entry-title" href="{{ p.url }}">{{ wm.clean_title(p) }}</a>
                        {{ wm.excerpt(p) }}
                        {{ wm.date(p) }}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <ul class="wiki-entry-list">
            <li class="wiki-entry wiki-entry-standalone">
                <a class="wiki-entry-title" href="{{ section.url }}">{{ wm.clean_title(section) }}</a>
                {{ wm.excerpt(section) }}
                {{ wm.date(section) }}
            </li>
        </ul>
    {% endif %}
{% endfor %}
