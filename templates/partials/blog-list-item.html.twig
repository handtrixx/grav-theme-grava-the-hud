{% set image = page.media.images|first %}
{% import 'partials/wiki-macros.html.twig' as wm %}
{# News-site row: one article per row, preview image on the left.
   Posts without media get a terminal placeholder tile instead of a gap.
   Layout in css/custom.css. #}
<article class="blog-row h-entry">
    {% if image %}
    <a class="blog-row-media" href="{{ page.url }}" tabindex="-1" aria-hidden="true">
        {{ image.cropZoom(480, 300).html|raw }}
    </a>
    {% else %}
    <div class="blog-row-media blog-row-placeholder">
        <svg viewBox="0 0 480 300" aria-hidden="true" focusable="false">
            <rect x="40" y="44" width="400" height="200" rx="10" fill="none" stroke="currentColor" stroke-width="2"/>
            <circle cx="122" cy="104" r="22" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M62 224 L172 136 L248 194 L318 128 L418 224" fill="none" stroke="currentColor" stroke-width="2"/>
            <text x="240" y="274" text-anchor="middle" font-size="15" fill="currentColor">// no preview</text>
        </svg>
    </div>
    {% endif %}
    <div class="blog-row-body">
        <div class="blog-row-meta">
            {% include 'partials/blog/date.html.twig' %}
        </div>
        {% include 'partials/blog/title.html.twig' with {title_level: 'h3'} %}
        <div class="blog-row-summary">
            {# One muted line, not the article's own summary: Grav builds that
               from the body, so it repeats the title and drags in headings and
               lists. wm.excerpt uses header.description when present, otherwise
               the stripped summary, and cuts at 220 characters. #}
            {{ wm.excerpt(page) }}
        </div>
        <div class="blog-row-tags">
            {% include 'partials/blog/taxonomy.html.twig' %}
        </div>
    </div>
</article>
