{# Speculation Rules (Chrome/Edge 121+, fail-safe: unknown keys are ignored,
   unsupported browsers simply never see this). Prerender ONLY, and only on
   the pointerdown gesture (conservative = Chrome default): the prerender
   belongs to the same user gesture as the navigation.
   NO hover rules: both "prerender: moderate" and "prefetch: moderate"
   swallowed the first click while the speculation was in flight
   (Niklas on QAS, 2026-11-28; fixed by removing hover eagerness).
   Exclusions: non-HTML targets and the QAS oauth endpoints. #}
<script type="speculationrules">
{
  "prerender": [{
    "where": "a[href]",
    "eagerness": "conservative",
    "not_href_matches": [
      "/media/*", "/oauth2/*", "/gitsync/*",
      "*.md", "*.pdf", "*.zip", "*.xml", "*.json", "*.txt", "*.rss",
      "*.css", "*.js", "*.png", "*.jpg", "*.jpeg", "*.webp", "*.svg", "*.gif", "*.ico"
    ]
  }]
}
</script>
