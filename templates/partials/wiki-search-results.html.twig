{% import 'partials/wiki-macros.html.twig' as wm %}

{# Result rows for the search page. Kept as a partial so the macros resolve:
   inside an {% embed %} block, `import _self` points at the embedded
   template, not the outer one. Row rendering lives in wiki-macros. #}
{% set results = search_results|default([])|filter(p => p.published and p.route starts with '/wiki') %}

{% if query %}
    <p class="wiki-search-summary">
        {{ results|length == 1
            ? 'THEME_GRAVA_HUD.WIKI.RESULTS_ONE'|t(query)
            : 'THEME_GRAVA_HUD.WIKI.RESULTS_MANY'|t(query, results|length) }}
    </p>
    {% if results|length %}
        <ul class="wiki-entry-list">
            {% for p in results %}{{ wm.search_row(p) }}{% endfor %}
        </ul>
    {% else %}
        <p class="wiki-search-empty">{{ 'THEME_GRAVA_HUD.WIKI.RESULTS_NONE'|t(query) }}</p>
    {% endif %}
{% else %}
    <p class="wiki-search-empty">{{ 'THEME_GRAVA_HUD.WIKI.SEARCH_HINT'|t }}</p>
{% endif %}
