{% import 'partials/wiki-macros.html.twig' as wm %}

{# Site-wide search rows, grouped by section. SimpleSearch hands us every
   published page; the search page itself never lists itself. Routes carry the
   language prefix (en/wiki/...), so the section is read from the URL: the
   first segment after en/de. Blog reads newest first, everything else by
   title. Row rendering lives in wiki-macros (same rows as wiki listings). #}
{% set results = search_results|default([])|filter(p => p.published and p.url != '/search') %}

{% set groups = {} %}
{% for p in results %}
    {% set parts = p.url|split('/')|filter(x => x is not empty) %}
    {% set root = parts[0] in ['en', 'de'] ? parts[1]|default(parts[0]) : parts[0] %}
    {% set groups = groups|merge({ (root): groups[root]|default([])|merge([p]) }) %}
{% endfor %}

{% set known = ['blog', 'wiki', 'zoo'] %}
{% set sections = [] %}
{% for key in known|filter(k => groups[k] is defined)|merge(groups|keys|filter(k => k not in known)|sort) %}
    {% set items = groups[key] %}
    {% set items = key == 'blog' ? items|sort((a, b) => b.date <=> a.date) : items|sort((a, b) => a.title <=> b.title) %}
    {% set label = key == 'blog' ? 'THEME_GRAVA_HUD.SEARCH.GROUP_POSTS'
        : key == 'wiki' ? 'THEME_GRAVA_HUD.SEARCH.GROUP_WIKI'
        : key == 'zoo' ? 'THEME_GRAVA_HUD.SEARCH.GROUP_ZOO'
        : 'THEME_GRAVA_HUD.SEARCH.GROUP_PAGES' %}
    {% set sections = sections|merge([{ key: key, label: label, items: items }]) %}
{% endfor %}

{% if query %}
    <p class="wiki-search-summary">
        {{ results|length == 1
            ? 'THEME_GRAVA_HUD.SEARCH.RESULTS_ONE'|t(query)
            : 'THEME_GRAVA_HUD.SEARCH.RESULTS_MANY'|t(query, results|length) }}
    </p>

    {% if sections|length %}
        {% for section in sections %}
            <section class="search-group">
                <h2>{{ section.label|t }} <span class="search-group-count">{{ section.items|length }}</span></h2>
                <ul class="wiki-entry-list">
                    {% for p in section.items %}{{ wm.search_row(p) }}{% endfor %}
                </ul>
            </section>
        {% endfor %}
    {% else %}
        <p class="wiki-search-empty">{{ 'THEME_GRAVA_HUD.SEARCH.RESULTS_NONE'|t(query) }}</p>
    {% endif %}
{% else %}
    <p class="wiki-search-empty">{{ 'THEME_GRAVA_HUD.SEARCH.HINT'|t }}</p>
{% endif %}
