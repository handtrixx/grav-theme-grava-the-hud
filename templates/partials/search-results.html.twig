{% import 'partials/wiki-macros.html.twig' as wm %}

{# Site-wide search rows, grouped by section. SimpleSearch hands us every
   published page; the search page itself never lists itself. Routes carry the
   language prefix (en/wiki/...), so the section comes from the URL: the first
   segment after en/de. No computed-key array merge (Twig here evaluates
   `(expr)` keys literally) - four buckets instead. Blog newest first, the
   rest by title; rows are wiki-macros search_row, same as wiki listings. #}
{% set results = search_results|default([])|filter(p => p.published and p.url != '/search') %}

{% set posts = [] %}
{% set wiki = [] %}
{% set zoo = [] %}
{% set pages = [] %}
{% for p in results %}
    {# Grav's Twig build drops everything on `x is not empty` inside an arrow
       filter, so compare against ''. URL parts: ['', 'en', 'wiki', ...] —
       the section is the segment after the language prefix. #}
    {% set parts = p.url|split('/')|filter(x => x != '') %}
    {% set root = (parts[0] in ['en', 'de']) ? parts[1] : parts[0] %}
    {% if root == 'blog' %}
        {% set posts = posts|merge([p]) %}
    {% elseif root == 'wiki' %}
        {% set wiki = wiki|merge([p]) %}
    {% elseif root == 'zoo' %}
        {% set zoo = zoo|merge([p]) %}
    {% else %}
        {% set pages = pages|merge([p]) %}
    {% endif %}
{% endfor %}

{% set sections = [] %}
{% if posts|length %}
    {% set sections = sections|merge([{ label: 'THEME_GRAVA_HUD.SEARCH.GROUP_POSTS', items: posts|sort((a, b) => b.date <=> a.date) }]) %}
{% endif %}
{% if wiki|length %}
    {% set sections = sections|merge([{ label: 'THEME_GRAVA_HUD.SEARCH.GROUP_WIKI', items: wiki|sort((a, b) => a.title <=> b.title) }]) %}
{% endif %}
{% if zoo|length %}
    {% set sections = sections|merge([{ label: 'THEME_GRAVA_HUD.SEARCH.GROUP_ZOO', items: zoo|sort((a, b) => a.title <=> b.title) }]) %}
{% endif %}
{% if pages|length %}
    {% set sections = sections|merge([{ label: 'THEME_GRAVA_HUD.SEARCH.GROUP_PAGES', items: pages|sort((a, b) => a.title <=> b.title) }]) %}
{% endif %}


{% if query %}
    <p class="wiki-search-summary">
        {{ results|length == 1
            ? 'THEME_GRAVA_HUD.SEARCH.RESULTS_ONE'|t(query)
            : 'THEME_GRAVA_HUD.SEARCH.RESULTS_MANY'|t(query, results|length) }}
    </p>

    {% if sections|length %}
        {% for section in sections %}
            <section class="search-group">
                <h2>{{ section.label|t }} <span class="search-group-count">{{ section.items|length }}</span></h2>
                <ul class="wiki-entry-list">
                    {% for p in section.items %}{{ wm.search_row(p) }}{% endfor %}
                </ul>
            </section>
        {% endfor %}
    {% else %}
        <p class="wiki-search-empty">{{ 'THEME_GRAVA_HUD.SEARCH.RESULTS_NONE'|t(query) }}</p>
    {% endif %}
{% else %}
    <p class="wiki-search-empty">{{ 'THEME_GRAVA_HUD.SEARCH.HINT'|t }}</p>
{% endif %}
