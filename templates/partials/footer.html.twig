<footer id="footer" class="section section-tight">
    <div class="container">
        <p>
            <i class="fa-solid fa-code" aria-hidden="true"></i>
            with <i class="fa-solid fa-heart pulse" aria-hidden="true"></i>
            by Niklas Stephan using
            <a href="https://github.blog/ai-and-ml/github-copilot/beyond-code-generation-a-developers-guide-to-agentic-engineering/"
               target="_blank" rel="noopener noreferrer"
               title="Beyond Code Generation: a developer's guide to agentic engineering">HDAE</a>.
        </p>
        {% set imprint = page.find('/imprint') %}
        {% set privacy = page.find('/privacy') %}
        {% if imprint and privacy %}
            <p class="hud-footer-links">
                <span class="prompt">$</span> ./links →
                <a href="{{ imprint.url }}">{{ imprint.title }}</a>
                ·
                <a href="{{ privacy.url }}">{{ privacy.title }}</a>
            </p>
        {% endif %}
    </div>
</footer>
