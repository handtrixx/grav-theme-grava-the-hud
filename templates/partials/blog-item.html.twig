<article class="content-item h-entry">

    {# Title, date and tags live in the page header band above (item.html.twig);
       the markdown's own leading `#` heading is dropped so it doesn't repeat. #}
    <div class="e-content">
        {{ page.content|without_first_heading|raw }}
    </div>

    {% if page.header.continue_link is same as(true) and config.plugins.comments.enabled %}
        {% include 'partials/comments.html.twig' ignore missing %}
    {% endif %}
</article>

<nav class="prev-next" aria-label="{{ 'THEME_GRAVA_HUD.ARIA.POST_NAVIGATION'|t|e('html_attr') }}">
    {% if not page.isLast %}
        <a class="btn btn-ghost" href="{{ page.prevSibling.url }}"><i class="fa-solid fa-angle-left" aria-hidden="true"></i> {{ 'THEME_GRAVA_HUD.BLOG.ITEM.PREV_POST'|t }}</a>
    {% else %}<span></span>{% endif %}

    {% if not page.isFirst %}
        <a class="btn btn-ghost" href="{{ page.nextSibling.url }}">{{ 'THEME_GRAVA_HUD.BLOG.ITEM.NEXT_POST'|t }} <i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
    {% else %}<span></span>{% endif %}
</nav>
