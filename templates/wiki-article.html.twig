{% extends 'partials/base.html.twig' %}
{% import 'partials/wiki-macros.html.twig' as wm %}

{# Wiki article page (docs layout): the terminal header band sits at the
   container edge like every other page, the tree sidebar and the article
   below it. Used when a page sets `template: wiki-article` explicitly;
   wiki.html.twig covers pages the theme assigns automatically. #}
{% set show_breadcrumbs = header_var('show_breadcrumbs')|defined(true) %}

{% block body %}
    <section id="body-wrapper" class="section wiki-article">
        <div class="container">
            <header class="wiki-page-header">
                <h1>{{ wm.clean_title(page) }}</h1>
                {% if page.header.subtitle %}
                    <p class="lead">{{ page.header.subtitle }}</p>
                {% endif %}
            </header>
            {% if show_breadcrumbs %}
                {% include 'partials/wiki-breadcrumbs.html.twig' %}
            {% endif %}
            {% embed 'partials/wiki-layout.html.twig' %}
                {% block item %}
                    <article class="content-item">
                        {{ page.content|without_first_heading|raw }}
                    </article>
                    {% include 'partials/wiki-prevnext.html.twig' %}
                {% endblock %}
            {% endembed %}
        </div>
    </section>
{% endblock %}
